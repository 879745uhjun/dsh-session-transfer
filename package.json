{
  "name": "dsh-session-transfer",
  "version": "1.3.2",
  "description": "Pack any DSH session, its subagent sessions and attachments into a portable .dshpack, and import it into another DSH installation.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/zip": "./lib/zip.mjs",
    "./lib/pack": "./lib/pack.mjs",
    "./lib/transfer": "./lib/transfer.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "transfer",
    "export",
    "import",
    "migration"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "pretest": "node scripts/check-syntax.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "license": "MIT",
  "author": "879745uhjun",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-session-transfer.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-session-transfer#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-session-transfer/issues"
  }
}
